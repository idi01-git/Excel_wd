// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  COORDINATOR
  TECH_LEAD
  CONTENT_LEAD
  PR_HEAD
  OPERATIONS_HEAD
  TREASURER
  MEMBER
  ALUMNI
  VISITOR
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum MemberSection {
  COORDINATORS
  CORE
  TEAM
}

enum Language {
  ENGLISH
  HINDI
}

enum PublicationCategory {
  ARTICLE
  STORY
  POEM
  REVIEW
}

enum PublicationStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
}

enum InteractionType {
  LIKE
  DISLIKE
  BOOKMARK
}

model User {
  id                 String             @id @default(uuid())
  name               String
  username           String             @unique
  email              String             @unique
  passwordHash       String
  role               Role               @default(VISITOR)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  isVerified         Boolean            @default(false)
  rollNumber         String?
  branch             String?
  batch              String?
  memberSection      MemberSection?     @default(TEAM)
  memberTitle        String?
  profilePhoto       String?
  directoryPhoto     String?
  bio                String?
  socialLinks        Json?
  showSocialLinks    Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  publications       Publication[]
  interactions       Interaction[]
  comments           Comment[]
  commentUpvotes     CommentUpvote[]
  commentDownvotes   CommentDownvote[]

  followers          Follow[]           @relation("FollowingRelationFollowers")
  following          Follow[]           @relation("FollowingRelationFollowing")
  notifications      Notification[]     @relation("RecipientNotifications")
  actorNotifications Notification[]     @relation("ActorNotifications")
  alumniProfile      AlumniProfile?

  eventRegistrations EventRegistration[]
  eventReports       EventReport[]
  bookReviews        BookReview[]
  bookReviewUpvotes  BookReviewUpvote[]
  issueRequests      IssueRequest[]
  approvedRequests   IssueRequest[]     @relation("IssueRequestApprover")
  returnedRequests   IssueRequest[]     @relation("IssueRequestReturner")
  auditLogs          AuditLog[]
}

model Publication {
  id             String              @id @default(uuid())
  title          String
  slug           String              @unique
  content        Json                // TipTap JSON state
  coverImage     String?
  category       PublicationCategory
  language       Language            @default(ENGLISH)
  tags           String[]
  authorId          String
  author            User                @relation(fields: [authorId], references: [id])
  authorName        String?
  authorNote        String?
  alumniProfileId   String?
  alumniProfile     AlumniProfile?      @relation(fields: [alumniProfileId], references: [id])
  status            PublicationStatus   @default(DRAFT)
  rejectionNote     String?
  readingTime       Int                 @default(1)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  publishedAt       DateTime?

  interactions   Interaction[]
  comments       Comment[]

  @@index([authorId, status])
  @@index([status, category])
}

model Interaction {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  publicationId String
  publication   Publication     @relation(fields: [publicationId], references: [id])
  type          InteractionType
  createdAt     DateTime        @default(now())

  @@unique([userId, publicationId, type])
}

model Comment {
  id              String      @id @default(uuid())
  content         String
  authorId        String
  author          User        @relation(fields: [authorId], references: [id])
  
  publicationId   String?
  publication     Publication? @relation(fields: [publicationId], references: [id])
  
  editorShelfId   String?
  editorShelf     EditorShelfItem? @relation(fields: [editorShelfId], references: [id])
  
  parentCommentId String?
  parent          Comment?    @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies         Comment[]   @relation("CommentReplies")
  upvotesCount    Int         @default(0)
  downvotesCount  Int         @default(0)
  isDeleted       Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  upvotes         CommentUpvote[]
  downvotes       CommentDownvote[]

  @@index([publicationId, parentCommentId])
  @@index([editorShelfId, parentCommentId])
}

model CommentUpvote {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId   String
  comment     Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, commentId])
}

model CommentDownvote {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId   String
  comment     Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, commentId])
}

enum NotificationType {
  LIKE
  COMMENT_REPLY
  MENTION
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
  NEW_FOLLOWED_POST
  EVENT_REGISTRATION_CONFIRMED
  EVENT_UPDATE
  EVENT_WINNER_ANNOUNCED
  ISSUE_REQUEST_APPROVED
  ISSUE_REQUEST_REJECTED
  ACCOUNT_VERIFICATION_REQUEST
  ACCOUNT_VERIFIED
  ACCOUNT_REJECTED
  ROLE_CHANGED
}

enum GalleryItemType {
  PHOTO
  VIDEO
  POSTER
  MEMORY
}

enum AchievementCategory {
  COMPETITION
  PUBLICATION
  AWARD
  MILESTONE
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("FollowingRelationFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("FollowingRelationFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model Notification {
  id              String           @id @default(uuid())
  recipientId     String
  recipient       User             @relation("RecipientNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  type            NotificationType
  actorId         String?
  actor           User?            @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: Cascade)
  entityType      String
  entityId        String
  message         String?
  isRead          Boolean          @default(false)
  createdAt       DateTime         @default(now())

  eventId         String?
  event           Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead])
}

// ─── 1. SEPARATE 3D EDITOR'S SHELF SYSTEM ──────────────────────────────────
model EditorShelfItem {
  id             String    @id @default(uuid())
  title          String
  author         String
  slug           String    @unique
  coverImage     String?
  editorialNote  String
  synopsis       String?
  excerpt        String?
  genre          String[]
  spineColor     String?   @default("#182b5e")
  spineTextColor String?   @default("#f3ecd8")
  coverColor     String?   @default("#1c3370")
  coverTextColor String?   @default("#f3ecd8")
  motif          String?   @default("lattice")
  foilColor      String?   @default("#e7b55f")
  width          Float?    @default(2.0)
  height         Float?    @default(3.1)
  spineThickness Float?    @default(0.42)
  readLink       String?   @default("/publications")
  displayOrder   Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  comments       Comment[]

  @@index([displayOrder, createdAt])
}

model AlumniProfile {
  id                String   @id @default(uuid())
  userId            String?  @unique
  user              User?    @relation(fields: [userId], references: [id])
  name              String
  photo             String?
  batch             String
  branch            String
  currentPosition   String?
  excelsiorPosition String?
  message           String?
  
  // Restricted Contact Info
  instagram         String?
  linkedin          String?
  email             String?
  phone             String?
  showSocialsToTeam Boolean       @default(true)
  publications      Publication[]
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model GalleryItem {
  id               String          @id @default(uuid())
  type             GalleryItemType
  url              String
  caption          String?
  eventId          String?
  isFeaturedOnHome Boolean         @default(false)
  uploadedById     String?
  createdAt        DateTime        @default(now())
}

model Achievement {
  id          String              @id @default(uuid())
  title       String
  description String
  category    AchievementCategory
  date        DateTime
  image       String?
  createdAt   DateTime            @default(now())
}

enum EventStatus {
  UPCOMING
  PAST
  CANCELLED
  POSTPONED
  DELAYED
  LIVE
  RESCHEDULED
}

enum BookAvailabilityStatus {
  AVAILABLE
  ISSUED
  MAINTENANCE
}

enum IssueRequestStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

enum WinnerPosition {
  FIRST
  SECOND
  THIRD
  CONSOLATION
  SPECIAL_MENTION
  OTHER
}

model Event {
  id                  String      @id @default(uuid())
  title               String
  slug                String      @unique
  description         String
  posterImage         String?
  coverImage          String?
  date                DateTime
  time                String?
  venue               String
  status              EventStatus @default(UPCOMING)
  isCompetition       Boolean     @default(false)
  maxCapacity         Int?
  rulebookUrl         String?
  socialLink          String?
  downloadUrl         String?
  customFormFields    Json?
  googleSheetUrl      String?
  googleSheetId       String?
  requirePayment      Boolean     @default(false)
  paymentQrImage      String?
  paymentAmount       String?
  paymentInstructions String?
  internalReportUrl   String?
  externalReportUrl   String?
  internalGalleryUrl  String?
  externalGalleryUrl  String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  registrations       EventRegistration[]
  winners             EventWinner[]
  report              EventReport?
  gallery             EventGalleryItem[]
  notifications       Notification[]

  @@index([status, date])
}

model EventRegistration {
  id                   String   @id @default(uuid())
  eventId              String
  event                Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  email                String
  phone                String?
  extraFields          Json?
  paymentScreenshotUrl String?
  paymentStatus        String?  @default("PENDING")
  paymentVerifiedAt    DateTime?
  registeredAt         DateTime @default(now())

  @@index([eventId, userId])
  @@index([eventId])
}

model EventWinner {
  id              String        @id @default(uuid())
  eventId         String
  event           Event         @relation(fields: [eventId], references: [id])
  participantName String
  photoUrl        String?
  position        WinnerPosition
  prize           String?
  description     String?
  createdAt       DateTime      @default(now())

  @@index([eventId])
}

model EventReport {
  id          String   @id @default(uuid())
  eventId     String   @unique
  event       Event    @relation(fields: [eventId], references: [id])
  title       String
  content     Json     // TipTap JSON state
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EventGalleryItem {
  id           String          @id @default(uuid())
  eventId      String
  event        Event           @relation(fields: [eventId], references: [id])
  url          String
  caption      String?
  type         GalleryItemType
  uploadedById String?
  createdAt    DateTime        @default(now())

  @@index([eventId])
}

// ─── 2. SEPARATE PHYSICAL SOCIETY LIBRARY SYSTEM ───────────────────────────
model Book {
  id                 String                 @id @default(uuid())
  title              String
  author             String
  coverImage         String?
  description        String
  genre              String[]
  language           Language               @default(ENGLISH)
  isbn               String?
  pageCount          Int?
  publishedYear      Int?
  availabilityStatus BookAvailabilityStatus @default(AVAILABLE)
  totalCopies        Int                    @default(1)
  issuedCopies       Int                    @default(0)
  amazonLink         String?
  downloadLink       String?
  clubReview         String?
  endorseCount       Int                    @default(0)
  themeColor         String?
  editorPickType     String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  reviews            BookReview[]
  issueRequests      IssueRequest[]

  @@index([availabilityStatus])
  @@index([genre])
  @@index([language])
  @@index([editorPickType])
}

model BookReview {
  id           String     @id @default(uuid())
  bookId       String
  book         Book       @relation(fields: [bookId], references: [id])
  reviewerId   String
  reviewer     User       @relation(fields: [reviewerId], references: [id])
  rating       Int
  reviewText   String
  upvotesCount Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  upvotes      BookReviewUpvote[]

  @@unique([bookId, reviewerId])
  @@index([bookId])
}

model BookReviewUpvote {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId  String
  review    BookReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([userId, reviewId])
}

model IssueRequest {
  id               String             @id @default(uuid())
  bookId           String
  book             Book               @relation(fields: [bookId], references: [id])
  requesterId      String
  requester        User               @relation(fields: [requesterId], references: [id])
  approverId       String?
  approver         User?              @relation("IssueRequestApprover", fields: [approverId], references: [id])
  returnerId       String?
  returner         User?              @relation("IssueRequestReturner", fields: [returnerId], references: [id])
  status           IssueRequestStatus @default(PENDING)
  requestDate      DateTime           @default(now())
  issueDate        DateTime?
  returnDate       DateTime?
  dueDate          DateTime?
  lastReminderSent DateTime?
  adminNote        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([bookId, status])
  @@index([requesterId, status])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  target     String?
  meta       Json?
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model EmailOtp {
  id        String   @id @default(uuid())
  email     String
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}
